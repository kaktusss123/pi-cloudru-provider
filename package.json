{
  "name": "pi-cloudru-provider",
  "version": "1.0.3",
  "description": "Native Cloud.ru Foundation Models provider for Pi 0.85.1+.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "cloud.ru",
    "llm",
    "coding-agent"
  ],
  "files": [
    "extensions",
    "src",
    "fixtures/cloudru-models.json",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "smoke": "node --experimental-strip-types test/smoke.mjs",
    "check:types": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
