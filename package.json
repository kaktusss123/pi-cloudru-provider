{
  "name": "pi-cloudru-provider",
  "version": "1.0.3",
  "description": "Production Cloud.ru Foundation Models provider for Oh My Pi with dynamic discovery, model-native reasoning transport, modalities, context limits, and pricing.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "omp-plugin",
    "omp-extension",
    "oh-my-pi",
    "cloud.ru",
    "llm",
    "coding-agent"
  ],
  "files": [
    "extensions",
    "src",
    "fixtures/cloudru-models.json",
    "README.md",
    "LICENSE"
  ],
  "omp": {
    "extensions": [
      "./extensions/cloudru-provider.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "smoke": "node --experimental-strip-types test/smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  }
}
